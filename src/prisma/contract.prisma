// use prisma-8

enum TranslationStatus {
  Pending
  Translated
  Review
  Approved
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  projects  Project[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Project {
  id        Int      @id @default(autoincrement())
  title     String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  sourceLanguage   Language? @relation("SourceLanguage", fields: [sourceLanguageId], references: [id])
  sourceLanguageId Int?
  languages Language[] @relation("ProjectLanguages")
  keys Key[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Language {
  id        Int      @id @default(autoincrement())
  code String
  name String
  project    Project     @relation("ProjectLanguages", fields: [projectId], references: [id], onDelete: Cascade)
  projectId  Int
  sourceForProjects Project[] @relation("SourceLanguage")
  translations Translation[]

  @@unique([projectId, code])
}

model Key {
  id Int @id @default(autoincrement())
  key String
  sourceText String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  translations Translation[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([projectId, key])
}

model Translation {
  id Int @id @default(autoincrement())
  key Key @relation(fields: [keyId], references: [id],  onDelete: Cascade)
  keyId Int
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  languageId Int
  text String?
  status TranslationStatus
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([keyId, languageId])
}